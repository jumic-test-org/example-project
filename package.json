  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1109.0",
    "@eslint/js": "^10.0.1",
    "@types/aws-lambda": "^8.10.162",
    "@types/jest": "^30",
    "@types/node": "^24.13.3",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.66.0",
    "aws-cdk": "^2.1136.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "jest": "^30",
    "jiti": "^2.7.0",
    "prettier": "^3.9.6",
    "ts-jest": "^29",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.67.0"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "aws-cdk-lib": "^2.266.0",
